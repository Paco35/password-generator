BEGIN:VEVENT
UID:1b1379b2-8d90-4c5a-8df3-7650a15167f1@12wk-health-plan
SUMMARY:Post-dinner walk (10–15 min)
DTSTART:20260615T193000
DTEND:20260615T194500
RRULE:FREQ=DAILY;COUNT=84
DESCRIPTION:Walk after your two biggest meals — this blunts the glucose s
 pike more than almost anything else.\nCounts towards your daily step targe
 t.\nBest single habit for your HbA1c.
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT0M
DESCRIPTION:Reminder
END:VALARM
END:VEVENT
